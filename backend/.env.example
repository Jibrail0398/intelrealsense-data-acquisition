# Copy to .env and adjust. Every value here is optional.

# auto | realsense | mock
#   auto/realsense: use a RealSense camera plugged into USB (via pyrealsense2)
#   mock:           synthetic frames, to try the app without a camera
CAMERA_BACKEND=auto

# Connect automatically on startup and whenever the camera is plugged in
CAMERA_AUTO_CONNECT=true

LOG_LEVEL=INFO

# SQLite database (history, projects, settings). Default: backend/data/app.db
# DATABASE_URL=sqlite:////absolute/path/to/app.db

PREVIEW_FPS=15
PREVIEW_JPEG_QUALITY=80
